<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">


  <Viewbox>
    <Grid x:Name="BaseScreen" Width="1920" Height="1080" HorizontalAlignment="Center" VerticalAlignment="Center">
		<Grid x:Name="BaseFrame" Width="1440" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">
                <Grid Width="1200" Height="768">
                    <Image x:Name="Background" Width="400" Height="400" Source="Textures/logo_mudinho.png" />

                    <Grid x:Name="UpdateScene" VerticalAlignment="Bottom" Margin="10,10,10,50" MaxWidth="1200">
                        <StackPanel Orientation="Vertical" Margin="10,10,10,10">
                            <Canvas>
                                <TextBlock x:Name="ProgressName" Canvas.Top="-35" Canvas.Left="30" Text="" />
                                <TextBlock x:Name="ProgressMissingItems" Canvas.Top="-35" Canvas.Right="30" Text="" />
                            </Canvas>

                            <ProgressBar Name="ProgressUpdate" HorizontalAlignment="Center" Width="1200" Height="15" Value="0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LoadingScene" VerticalAlignment="Bottom" Margin="10,10,10,50" MaxWidth="1200">
                        <TextBlock x:Name="LoadingText" Text="Aguarde, carregando..." />
                    </Grid>
                </Grid>
            </Grid>
	</Grid>
  </Viewbox>
</UserControl>